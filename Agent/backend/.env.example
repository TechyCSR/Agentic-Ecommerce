# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-in-production

# Database (own Postgres database, independent of Merchant/backend's)
DATABASE_URL=postgresql://agentic_agent:agentic_agent@localhost:5432/agentic_commerce_agent

# Clerk (own instance, independent of Merchant's — JWT verification only)
CLERK_ISSUER=https://your-agent-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-agent-app.clerk.accounts.dev/.well-known/jwks.json

# Merchant Phase 1 agent API (central key, catalog:read + product:read)
MERCHANT_AGENT_API_URL=http://localhost:5000
MERCHANT_AGENT_API_KEY=ac_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# CORS
FRONTEND_ORIGIN=http://localhost:3100
