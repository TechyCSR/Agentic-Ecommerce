# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-in-production

# Database (same Neon/Postgres database Merchant/backend uses)
DATABASE_URL=postgresql://agentic:agentic@localhost:5432/agentic_commerce

# Clerk (same instance as Merchant — JWT verification only)
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Merchant Phase 1 agent API (central key, catalog:read + product:read)
MERCHANT_AGENT_API_URL=http://localhost:5000
MERCHANT_AGENT_API_KEY=ac_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# CORS
FRONTEND_ORIGIN=http://localhost:3100
