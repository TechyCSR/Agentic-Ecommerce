# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-in-production

# Database (own Postgres database, independent of Merchant/backend's)
DATABASE_URL=postgresql://agentic_agent:agentic_agent@localhost:5432/agentic_commerce_agent

# Clerk (own instance, independent of Merchant's — JWT verification only)
CLERK_ISSUER=https://your-agent-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-agent-app.clerk.accounts.dev/.well-known/jwks.json

# Merchant Phase 1 agent API (central key, catalog:read + product:read)
MERCHANT_AGENT_API_URL=http://localhost:5000
MERCHANT_AGENT_API_KEY=ac_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM — any OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://api.bluesminds.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o

# CORS
FRONTEND_ORIGIN=http://localhost:3100

# Razorpay (Test Mode) — secret never leaves the backend
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Max single order in paise (0 = no app-side limit). Set to your Razorpay
# account limit so over-limit carts fail at checkout with a clear message
# instead of being rejected inside the payment modal.
MAX_ORDER_AMOUNT=0
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AGENT_WEB_URL=https://agent.techycsr.dev

# Minutes to hold stock for a priced checkout while the buyer pays (max 60).
STOCK_RESERVATION_TTL_MINUTES=15
